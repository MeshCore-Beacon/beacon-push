# beacon-push settings. Copy to .env next to the compose file; never commit the real one.

# Where operators and the app reach the relay. Every mailed link is built from it.
PUSH_PUBLIC_URL=https://push.meshcorebeacon.ca

# Listen address inside the container, and the SQLite file (keep /data on a volume and back it up).
# PUSH_LISTEN_ADDR=:8080
# PUSH_DATABASE_PATH=/data/beacon-push.db

# In-container path of the Firebase service-account key file, for Android (mount it read-only).
PUSH_FIREBASE_CREDENTIALS=/run/secrets/firebase.json

# APNs auth key for iOS: in-container path of the .p8 file (mount it read-only), its 10-character key ID,
# the Apple team ID and the app's bundle ID.
PUSH_APNS_KEY=/run/secrets/apns.p8
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
PUSH_APNS_TOPIC=meshcorebeacon.app

# Outgoing mail for registration links and admin notices.
PUSH_SMTP_HOST=
# PUSH_SMTP_PORT=587
PUSH_SMTP_USERNAME=
PUSH_SMTP_PASSWORD=
PUSH_SMTP_FROM="Beacon Push <noreply@meshcorebeacon.ca>"
# PUSH_SMTP_STARTTLS=true

# Gets a mail for every new server, automatic suspensions and lost domain verifications. Empty sends none.
PUSH_ADMIN_EMAIL=abuse@meshcorebeacon.ca

# True behind Caddy: the client address is taken from the last X-Forwarded-For entry.
PUSH_TRUST_PROXY=true

# Logs mail and pushes instead of sending them, and lets the domain check reach local addresses. Never in production.
# PUSH_DEV_MODE=false
